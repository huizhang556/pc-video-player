QTabBar::tab
{
min-width:100px;
min-height: 20px;
color: #ffffff;
padding:5px;
font: 400 14px &quot;微软雅黑&quot;;
border: 0px solid;
border-top-left-radius: 10px;
border-top-right-radius: 10px;
/*background-color:qlineargradient(x1: 0, y1: 0, x2: 0.7, y2: 0.7,stop: 0.3 rgb(40,150,200,160),stop: 0.6 rgb(40,150,200,220),stop:1 rgb(40,150,200,255));*/
background-color:transparent;
}

QTabBar::tab:!selected
{
margin-top: 0px;
}

QTabBar::tab:selected
{
color: #00d1d1;
font-size:14px;
font-weight:bold;
background-color: rgba(212, 78, 125,0.0);
}</string>
