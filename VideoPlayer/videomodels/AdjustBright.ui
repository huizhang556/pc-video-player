         <property name="styleSheet">
          <string notr="true">QSlider
{
background-color:#2a2a31;
}
/*整个进度条*/
QSlider::groove:horizontal 
{
background:transparent;
height: 8px;
border-radius:4px;
}

/*J拖动按钮*/
QSlider::handle:horizontal 
{
background: qradialgradient(spread:pad, cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, 
stop:0.6 #45ADED, stop:0.778409 rgba(255, 255, 255, 255));
width: 8px;
height:8px;
margin-top: -2px;
margin-bottom: -2px;
padding-right:1px;
border-radius: 4px;
border:1px solid white;
}

/*J拖动按钮-hover*/
QSlider::handle:horizontal:hover 
{
border-radius: 4px;
background: qradialgradient(spread:pad, cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0.6 #2A8BDA,stop:0.778409 rgba(255, 255, 255, 255));
}

/*未划过的区域，右边界线*/
QSlider::add-page:horizontal,QSlider::add-line:horizontal
{
background-color: rgb(87, 97, 106); 
border-radius:4px;
}

/*已划过的区域，右边界线*/
QSlider::sub-page:horizontal,QSlider::sub-line:horizontal
{
/*background-color:qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(231,80,229, 255), stop:1 rgba(7,208,255, 255));*/
background-color:rgb(255, 94, 30);
border-radius:4px;
}
</string>
         </property>
         <property name="orientation">
          <enum>Qt::Horizontal</enum>
         </property>
        </widget>
