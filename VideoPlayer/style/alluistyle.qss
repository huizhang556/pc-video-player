{
background-color:white;
color:#2a2a31;
font:normal normal 15px '微软雅黑';
}

#pmenu_help1::item
{
height:18px;
padding: 4px 28px 4px 20px;/*上 右 下 左*/
border: 1px solid transparent;
}

#pmenu_help2::item
{
height:18px;
padding: 4px 8px 4px 12px;/*上 右 下 左*/
border: 1px solid transparent;
margin:0px;
}

#pmenu_help1::item:selected,#pmenu_help2::item:selected
{
border-radius: 5px;
background: #00aabf;
}

#pmenu_help1::icon,#pmenu_help2::icon
{
width:10px;
height:20px;
margin-left:10px;
}

/*帮助按钮菜单-----------------------样式结束*/

