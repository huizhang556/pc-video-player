#m_mainVideoMenu::indicator,#m_miniVideoMenu::indicator,#m_miniSub1Menu::indicator,#m_miniSub2Menu::indicator
{
padding-left: 10px;
width: 20px;
height: 20px;
}

/*菜单项指示器---互斥--选中*/
