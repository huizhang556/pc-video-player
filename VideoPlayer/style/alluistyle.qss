/*去掉dockwidget边界空白*/
QMainWindow::separator 
{
outline:0;
width:0px;
height:0px;
margin:0px;
padding:0px;
}

QDockWidget#m_dockWidget::title
{
text-align: center; 
background-color:rgb(101,210,105);
padding-left: 5px;
}

/*通过icon-size来撑大item的高度*/
QToolBox
{
border-right:2px;
background-color:#3d3d3d;
 icon-size: 25px; 
}

/*节目列表tabwidget*/
#m_tabWidget1
{
outline:none;
background-color:#3d3d3d;
color:black;
}

#m_tabWidget1 QTabBar::tab
{
width:130px;
height:35px;
color: white;
background-color:#3f3f48;
}

#m_tabWidget1 QTabBar::tab:first
{
/*border-right:1px solid #ff5c38;*/
}

#m_tabWidget1 QTabBar::tab:!selected
{
margin-top: 0px;
}

#m_tabWidget1 QTabBar::tab:selected
{
color:#ff5c38;
font-size:14px;
font-weight:bold;
border-bottom:2px solid #ff5c38;
}

/*抽屉控件,有效*/
QToolBox::tab
{
/*border: 2px groove transparent; */
border-bottom:2px groove blue; 
border-radius:2px;
background-color:#3d3d3d;
text-align: center; 
}

/*tab样式-hover*/
QToolBox::tab:hover
{
background-color:rgb(101,210,105);
color:lightgreen;
}

/*tab样式-selected*/
QToolBox::tab:selected
{
/*background-color:#7f7f7f;*/
background-color:rgb(101,210,105);
/*color:lightgreen;*/
}

