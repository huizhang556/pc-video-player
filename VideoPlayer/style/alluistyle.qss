/*所有控件需要有明确的对象名称，需要设置共同样式，指明控件的层次次序*/
/**所有的注释不要使用双斜杠!!!**/
/*全局通过用样式*/
* {
outline:none;
font-family: "微软雅黑";
}

/**依旧是万能大法所有可视化类的 Q_PROPERTY 包含的属性都可以这样设置**/
/**对整个系统的选项卡设置无切换按钮**/
QTabBar
{
/*对整个系统的选项卡设置无切换按钮*/
/*等同于ui->tabWidget->tabBar()->setUsesScrollButtons(false);*/
qproperty-usesScrollButtons: false;
}

/*去白边*/
QTabWidget::pane 
{
border-right: 0;
}

/*弹幕---登录按钮*/

/**登录状态按钮**/
#m_loginStatusBtn
{
border-radius: 7px;
background-color: #c0ff02;
}

MainWidget
{
/*整个主界面大背景，所有背景透明都继承此背景颜色*/
background-color: #2a2a31;
/*2px边界线颜色在这里设置*/
}

/*主界面标题栏---内衬*/
#stackedWidget_title
{
/*深蓝色*/
background-color: qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,stop:0 #2f4359, stop:1  #03223a);
/*渐变红*/
/*background-color: qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,stop:0 #e60012, stop:1  #c91116);*/
color: rgb(85, 255, 0);
}

