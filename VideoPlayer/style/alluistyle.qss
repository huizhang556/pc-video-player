/*********************浏览器---标题栏---右键菜单---start************************/
/**一级菜单+二级菜单**/

#pmenu_funclist,#pmenu_func_tool
{
background-color:white;
font: 400 12px "微软雅黑";
border-radius: 0px;
}

#pmenu_funclist::item,#pmenu_func_tool::item
{
background-color:white;
height:24px;
width: 160px;
/*padding不包括指示器和icon的部分*/
padding: 1px 0px 1px 15px;
/*height+padding共同决定item的高度*/
}

#pmenu_funclist::item:selected,#pmenu_func_tool::item:selected
{
color:#2ca5fc;
background-color:#cccccc;
}

#pmenu_funclist::icon,#pmenu_func_tool::icon
{
background-color: transparent;
padding-left: 6px;
width: 24px;
height: 24px;
}


#pmenu_funclist::indicator,#pmenu_func_tool::indicator
{
padding-left: 0px;
width: 0px;
height: 0px;
}

/*菜单项指示器---互斥--选中*/
#pmenu_funclist::indicator:exclusive:checked,#pmenu_func_tool::indicator:exclusive:checked
{
image: url(://images/tray/tray_checked.png);
}

/**分割线**/
#pmenu_func_tool::separator,#pmenu_func_tool::separator
{
height: 1px;
background: #cccccc;
}
/*********************浏览器---标题栏---右键菜单---end************************/

/*浏览器---状态栏*/
#m_statusBar
{
color: #cccccc;
}

/*浏览器---进度条*/
#m_progressBar
{
color: #cccccc;
}

/*浏览器---整个收藏栏(包括展开按钮、隐藏按钮)样式*/
#m_tabframe
{
background-color: #454c59;
border: 0px solid transparent;
}

/*浏览器---收藏栏tabbar样式*/
#m_tabBar
{
background-color: #454c59;
color: #4c4c4c;
border: 0px solid transparent;
}

/*浏览器---收藏栏tab样式*/
#m_tabBar::tab
{
min-width: 100px;
max-width: 100px;
/*magin-top和height实现tab居中，留下tabbar的大背景*/
height:18px;
margin-top:3px;
margin-left:1px;
margin-right:1px;
border-radius: 2px;
background-color: #48484c;
}

#m_tabBar::tab:first
{
margin-left: 2px;
}

#m_tabBar::tab:last
{
margin-right: 2px;
}

#m_tabBar::tab:selected
{
background-color: #ffffff;
}

#m_tabBar::tab:hover
{
background-color: #ffffff;
border-radius: 2px;
}

#m_tabBar::tab:!selected
{
