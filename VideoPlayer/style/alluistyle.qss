/*浏览器---状态栏*/
#m_statusBar
{
color: #cccccc;
}

/*浏览器---进度条*/
#m_progressBar
{
color: #cccccc;
}

/*浏览器---整个收藏栏(包括展开按钮、隐藏按钮)样式*/
#m_tabframe
{
background-color: #454c59;
border: 0px solid transparent;
}

/*浏览器---收藏栏tabbar样式*/
#m_tabBar
{
background-color: #454c59;
color: #4c4c4c;
border: 0px solid transparent;
}

/*浏览器---收藏栏tab样式*/
#m_tabBar::tab
{
min-width: 100px;
max-width: 100px;
/*magin-top和height实现tab居中，留下tabbar的大背景*/
height:18px;
margin-top:3px;
margin-left:1px;
margin-right:1px;
border-radius: 2px;
background-color: #48484c;
}

#m_tabBar::tab:first
{
margin-left: 2px;
}

#m_tabBar::tab:last
{
margin-right: 2px;
}

#m_tabBar::tab:selected
{
background-color: #ffffff;
}

#m_tabBar::tab:hover
{
background-color: #ffffff;
border-radius: 2px;
}

#m_tabBar::tab:!selected
{
background-color: #ffffff;
}

#m_tabBar::tab::tab:only-one
{
border-right-width:0px;
}

#m_tabBar QToolButton
{
background-color:transparent;
}

#m_tabBar QToolButton::right-arrow
{
background-color:transparent;
}

#m_tabBar QToolButton::left-arrow
{
background-color:transparent;
}

