/*菜单样式-通用样式*/

QLCDNumber
{
border:none;
/*font:bold italic 18px "微软雅黑";*/
}

/*m_widget1*/
#m_widget1
{
border:1px solid transapent;
border-left-color: #838383;
}

/*搜索框*/
QToolBox QWidget QLineEdit
{
color:#cccccc;
font-family:"微软雅黑";
font-size:14px;
background-color: rgb(81, 81, 81);
selection-background-color: #D1DBCB;
/*border:2px solid #76797C;*/
border:transparent;
border-top-left-radius:0;
border-top-right-radius:0;
border-bottom-right-radius:0;
border-bottom-left-radius:0;
border-right:-1px;
padding-right:-1px;
padding-left:15px;
}

QToolBox QWidget QLineEdit:hover
{
background-color: rgb(33, 33, 33);;
border-right:-2px;
border:1px solid transparent;
}

/*搜索按钮*/
QToolBox QWidget QPushButton
{
color:#ff5c38;
border:1px solid transparent;
background-color: rgb(75, 75, 75);
border-top-left-radius:0;
border-top-right-radius:0;
border-bottom-right-radius:0;
border-bottom-left-radius:0;
image: url(:/images/icon/file_open.png);
padding:2px;
}

/*搜索按钮-按下*/
QToolBox QWidget QPushButton:pressed
{
border-style: inset;
background-color: qconicalgradient(cx:0.5, cy:0.522909, angle:179.9, 
stop:0.494318 rgba(134, 198, 233, 255), stop:0.5 rgba(206, 234, 248, 255));
border: 1px solid #5F92B2;
}

/*搜索按钮-鼠标滑过*/
QToolBox QWidget QPushButton:hover
{
color:white;
/*border: 1px solid #D1DBCB;*/
padding:2px;
image: url(:/images/icon/file_open_hover.png);
}

/*listwidget-每个item上的按钮*/
QToolBox QWidget QListWidget QPushButton
{
color:#cccccc;
background-color:#3a3a3a;
/*
min-height:30px;
max-height:30px;
*/
} 

/*QListWidget播放列表*/
QToolBox QListWidget
{
/*background-color:qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0,
stop:0 rgba(231,80,229, 255), 
stop:1 rgba(7,208,255, 255));*/
background-color:#3d3d3d;
font-family:"Mircrosoft YaHei";
border:none;/*去掉边框线*/

}

QToolBox QListWidget::item
{
color:#cccccc;
background-color:#3a3a3a;
min-height:30px;
}

QToolBox QListWidget::item:hover
{
    show-decoration-selected:5;
    /*background-color: qconicalgradient(cx:0.5, cy:0.522909, angle:179.9, 
       stop:0.494318 rgba(181, 225, 250, 255), stop:0.5 rgba(222, 242, 251, 255));*/
    background-color:#707070;
    border-style:outset;
    color:#FF7F24;	
}

QToolBox QListWidget::item:selected
{
    /*border:0px;*/
    /*border:1px solid #55ff00;*/
    background:#382e15;
    padding:0px;
    margin:0px;
    color:#ff5c38;
}

/*上次选择后保留的状态，鼠标离开后显示*/
QToolBox QListWidget::item:selected:!active
{
    border-width:0px;
    background:#382e15;
    padding:0px;
    margin:0px;
    color: rgb(85, 255, 0);
}

QScrollBar:vertical
{
background-color:#3f3f48;
width:9px;
}

QScrollBar:horizontal
{
background-color:#3f3f48;
height:9px;
}

QScrollBar::handle:vertical
{
height:4px;
border-radius:4px;
background-color:#cdcdcd;
}

QScrollBar::handle:horizontal
{
width:4px;
border-radius:4px;
background-color:#cdcdcd;
}

QScrollBar::handle:vertical:hover
{
background-color:white;
border-radius:4px;
}

QScrollBar::handle:horizontal:hover
{
background-color:white;
border-radius:4px;
}

QScrollBar::sub-page:vertical
{
background-color:#038387;
}

QScrollBar::sub-page:horizontal
{
background-color:#038387;
}

QScrollBar::add-page:vertical
{
background-color:#038387;
}

QScrollBar::add-page:horizontal
{
background-color:#038387;
}

