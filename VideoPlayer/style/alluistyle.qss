QToolBox
{
border-right:2px;
background-color:#3d3d3d;
 icon-size: 25px; 
}

/*抽屉控件,有效*/
QToolBox::tab
{
border-bottom:2px groove blue; 
border-radius:2px;
background-color:#3d3d3d;
color: yellow;
text-align: center; 
}

/*tab样式-hover*/
