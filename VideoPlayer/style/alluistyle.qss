MainWidget
{
background-color:#2a2a31;
color: rgb(85, 255, 0);
}

/*推荐栏左右调节按钮*/
#m_recLeftBtn
{
border-radius:20px;
background: rbga(240, 240, 240,0.6) url(://images/icon/page_leftBtn.png) no-repeat no-repeat center center;
}
#m_recLeftBtn:hover
{
border-radius:20px;
background: rbga(240, 240, 240,0.6) url(://images/icon/page_leftBtn_hover.png) no-repeat no-repeat center center;
}

#m_recRightBtn
{
border-radius:20px;
background: rbga(240, 240, 240,0.6) url(://images/icon/page_rightBtn.png) no-repeat no-repeat center center;
}
#m_recRightBtn:hover
{
border-radius:20px;
background: rbga(240, 240, 240,0.6) url(://images/icon/page_rightBtn_hover.png) no-repeat no-repeat center center;
}

/*去白边*/
#m_tabWdgt::pane 
{
border-right: 0;
background-color: #3b3b45;
}

#m_tabWdgt::tab-bar 
{
left: 35px;
}

#m_homeListWidget
{
background-color:#2a2a31;
border:none;
}

#m_homeListWidget::item
{
background-color:#2a2a31;
border:none;
}

QListWidget QTabWidget QStackWidget QTextBrowser
{
outline:0;
border:none;/*去边线*/
}

MainWindow
{
background-color:#2a2a31;
color: rgb(85, 255, 0);
}

/*全局通过用样式*/
* {
outline:none;
}

/*去白边*/
QTabWidget::pane 
{
border-right: 0;
}

/*---侧边栏列表---*/
#listWidget_playlist
{
background-color: rgb(43, 43, 43);
font-family:"微软雅黑";
border:none;/*去掉边框线*/
icon-size:50px;
font-size:14px;
text-align:center;
}

/*侧边栏列表item*/
#listWidget_playlist::item
{
color:#cccccc;
background-color: rgb(43, 43, 43);
min-height:50px;/*有效设置item高度*/
padding-left:20px;
}

#listWidget_playlist::item:hover
{
show-decoration-selected:5;
/*background-color: qconicalgradient(cx:0.5, cy:0.522909, angle:179.9, 
stop:0.494318 rgba(181, 225, 250, 255), stop:0.5 rgba(222, 242, 251, 255));*/
border-style:outset;
color:#FF7F24;
background-color: rgb(33, 33, 33);
}

#listWidget_playlist::item:selected
{
/*border:0px;*/
/*border:1px solid #55ff00;*/
background:#382e15;
margin:0px;
color:#ff5c38;
}

/*上次选择后保留的状态，鼠标离开后显示*/
#listWidget_playlist::item:selected:!active
{
border-width:0px;
background:#382e15;
margin:0px;
color: rgb(85, 255, 0);
}

/*侧边栏底部--展开按钮*/
#m_expandBtn
{
background-color: rgb(43, 43, 43);
text-align:left;
icon-size:35px;
font-family:"微软雅黑";
font-size:14px;
color:#cccccc;
padding-left:38px;
}

#m_expandBtn:hover
{
background-color: rgb(33, 33, 33);
color:rgb(255, 94, 30);
}

QMenu
{
background-color:#3d3d3d;
margin: 2px;
font-size:14px;
/*定义宽度多级菜单就没有右边箭头*/
/*font:bold italic 14px "微软雅黑";*/
}

QMenu::item
{
color:#41cd52;
padding: 2px 25px 2px 20px;
border: 1px solid transparent;
}

QMenu::item:selected
{
border-color: darkblue;
background: #b5aaa8;
border-radius:4px;
color:red;
}

QMenu::icon
{
padding-left:15px;/*有效*/
}

