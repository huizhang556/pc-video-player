}

#pmenu_right::item:selected,#pmenu_songer::item:selected,#pmenu_son_addto::item:selected,#pmenu_son_sort::item:selected,#pmenu_son_playmode::item:selected,#pmenu_son_muctool::item:selected,#menuSelection::item:selected
