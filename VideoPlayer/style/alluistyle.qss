/*搜索框*/
QToolBox QWidget QLineEdit
{
color:#cccccc;
font-family:"微软雅黑";
font-size:14px;
background-color: rgb(81, 81, 81);
selection-background-color: #D1DBCB;
/*border:2px solid #76797C;*/
border:transparent;
border-top-left-radius:0;
border-top-right-radius:0;
border-bottom-right-radius:0;
border-bottom-left-radius:0;
border-right:-1px;
padding-right:-1px;
padding-left:15px;
}

QToolBox QWidget QLineEdit:hover
{
background-color: rgb(33, 33, 33);;
border-right:-2px;
border:1px solid transparent;
}

/*搜索按钮*/
QToolBox QWidget QPushButton
{
color:#ff5c38;
border:1px solid transparent;
background-color: rgb(75, 75, 75);
image: url(:/images/icon/file_open.png);
padding:2px;
}

/*搜索按钮-按下*/
QToolBox QWidget QPushButton:pressed
{
border-style: inset;
background-color: qconicalgradient(cx:0.5, cy:0.522909, angle:179.9, 
stop:0.494318 rgba(134, 198, 233, 255), stop:0.5 rgba(206, 234, 248, 255));
border: 1px solid #5F92B2;
}

/*搜索按钮-鼠标滑过*/
QToolBox QWidget QPushButton:hover
{
color:white;
/*border: 1px solid #D1DBCB;*/
padding:2px;
image: url(:/images/icon/file_open_hover.png);
}

/*QListWidget播放列表*/
QToolBox QWidget  QListWidget
{
/*background-color:qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0,
stop:0 rgba(231,80,229, 255), 
stop:1 rgba(7,208,255, 255));*/
background-color:#3d3d3d;
font-family:"Mircrosoft YaHei";
border:none;/*去掉边框线*/
}

QToolBox QWidget  QListWidget::item
{
color:#cccccc;
background-color:#3a3a3a;
min-height:30px;
font-size:15px;
}

QToolBox QWidget  QListWidget::item:hover
{
show-decoration-selected:5;
 /*background-color: qconicalgradient(cx:0.5, cy:0.522909, angle:179.9, 
       stop:0.494318 rgba(181, 225, 250, 255), stop:0.5 rgba(222, 242, 251, 255));*/
background-color:#707070;
border-style:outset;
color:white;
font-size:18px;	
}

QToolBox QWidget  QListWidget::item:selected
{
background:#382e15;
padding:0px;
margin:0px;
color:#ff5c38;
font-size:18px;
}

/*上次选择后保留的状态，鼠标离开后显示*/
QToolBox QWidget  QListWidget::item:selected:!active
{
border-width:0px;
background:#382e15;
padding:0px;
margin:0px;
color: rgb(85, 255, 0);
}

/*单独的统一放在通用样式之前设置*/
#list2_vertical_scrollBar::handle:vertical,#list3_vertical_scrollBar::handle:vertical,#list4_vertical_scrollBar::handle:vertical
{
background-color:#65d269;
border-radius:5px;
}

/*鼠标放到滑块上面样式*/
#list2_vertical_scrollBar::handle:vertical:hover,#list3_vertical_scrollBar::handle:vertical:hover,#list4_vertical_scrollBar::handle:vertical:hover
{
background-color:#c0ff02;
border-radius:5px;
}

/*滚动条滚过部分样式*/
#list2_vertical_scrollBar::sub-page:vertical,#list3_vertical_scrollBar::sub-page:vertical,#list4_vertical_scrollBar::sub-page:vertical
{
background-color:#038387;
}

/*滚动条未滚过部分样式*/
#list2_vertical_scrollBar::add-page:vertical,#list3_vertical_scrollBar::add-page:vertical,#list4_vertical_scrollBar::add-page:vertical
{
background-color:#038387;
}

/*滚动条整体样式，需要单独设置的，在下面按照层次顺序指明，或者按照对象名设置 --start*/
/*垂直滚动条整体样式*/
QScrollBar:vertical
{
background-color:#3f3f48;/*背景颜色*/
width:10px;/*整体宽度*/
}

/*水平滚动条整体样式*/
QScrollBar:horizontal
{
background-color:#3f3f48;/*背景颜色*/
height:10px;/*整体高度*/
}

/*垂直滚动条内滑块样式*/
QScrollBar::handle:vertical
{
min-height:20px;/*滑块宽度*/
border-radius:5px;/*滑块角度弯曲*/
background-color:#038387;
}

/*水平滚动条内滑块样式*/
QScrollBar::handle:horizontal
{
min-width:20px;/*滑块高度*/
border-radius:5px;/*滑块角度弯曲*/
background-color:#038387;
}

/*垂直滚动条内滑块样式--hover*/
QScrollBar::handle:vertical:hover
{
background-color:#6b9fa7;
border-radius:5px;
}

/*水平滚动条内滑块样式--hover*/
QScrollBar::handle:horizontal:hover
{
background-color:#6b9fa7;
border-radius:5px;
}

/*垂直滚动条滑过上部分的样式*/
QScrollBar::sub-page:vertical
{
background-color:#25252a;
}

/*水平滚动条滑过左部分的样式*/
QScrollBar::sub-page:horizontal
{
background-color:#25252a;
}

/*垂直滚动条滑过下部分的样式*/
QScrollBar::add-page:vertical
{
background-color:#25252a;
}

/*水平滚动条滑过右部分的样式*/
QScrollBar::add-page:horizontal
{
background-color:#25252a;
}

