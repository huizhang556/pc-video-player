{
background-color:rgb(101,210,105);
color: white;
}

/*tab样式-selected*/
QToolBox::tab:selected
{
background-color: #36a5c1;
color: white;
font-weight: bold;
}

/*右侧整个播放列表父亲m_widget1*/
#m_widget1
{
background-color: #072957；
border:1px solid transapent;
border-left-color: #3f4042;
}

/*toolbox承载区域控件*/


/*搜索框(事件监视器控制)*/
QToolBox QWidget QLineEdit
{
color:#cccccc;
font-family:"微软雅黑";
font-size:14px;
background-color: #162a33;
selection-background-color: #eaeaea;
padding-left:15px;
border:none;
}

/*搜索按钮(事件监视器控制)*/
QToolBox QWidget QPushButton
{
border: none;
background-color: #162a33;
image: url(:/images/icon/file_open.png);
padding:5px;
}

/*搜索按钮-按下*/
QToolBox QWidget QPushButton:pressed
{
border-style: inset;
background-color: #162a33;
}

/*搜索按钮-鼠标滑过*/
QToolBox QWidget QPushButton:hover
{
padding:5px;
image: url(:/images/icon/file_open_hover.png);
background-color: #162a33;
}

/**************************播放器右侧列表设置---开始****************************/
/*QListWidget播放列表*/
QToolBox QWidget  QListWidget
{
font-family:"Mircrosoft YaHei";
border:none;
background-color: #333333;
}

QToolBox QWidget  QListWidget::item
{
color:#cccccc;
min-height:30px;
font-size:15px;
background-color: #333333;
}

QToolBox QWidget  QListWidget::item:hover
{
show-decoration-selected:5;
background-color: qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,stop:0 #5104e4, stop:1  #8e2ce1);
border-style:outset;
color:white;
font-size:18px;	
}

QToolBox QWidget  QListWidget::item:selected
{
padding:0px;
margin:0px;
color:#ff5c38;
font-size:18px;
background-color: qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,stop:0 #c11432, stop:1  #730f33);
}

/*上次选择后保留的状态，鼠标离开后显示,会影响selected*/
QToolBox QWidget  QListWidget::item:selected:!active
{
border-width:0px;
padding:0px;
margin:0px;
color: rgb(85, 255, 0);
background-color: qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,stop:0 #c11432, stop:1  #730f33);
}

/**************************播放器右侧列表设置---完毕****************************/

/*四个列表的滚动条---单独的统一放在通用样式之前设置*/
#list1_vertical_scrollBar::handle:vertical,#list2_vertical_scrollBar::handle:vertical,#list3_vertical_scrollBar::handle:vertical,#list4_vertical_scrollBar::handle:vertical
{
background-color:#65d269;
border-radius:4px;
}

/*鼠标放到滑块上面样式*/
#list1_vertical_scrollBar::handle:vertical:hover,#list2_vertical_scrollBar::handle:vertical:hover,#list3_vertical_scrollBar::handle:vertical:hover,#list4_vertical_scrollBar::handle:vertical:hover
{
background-color:#c0ff02;
border-radius:4px;
}

/*滚动条滚过部分样式*/
#list1_vertical_scrollBar::sub-page:vertical,#list2_vertical_scrollBar::sub-page:vertical,#list3_vertical_scrollBar::sub-page:vertical,#list4_vertical_scrollBar::sub-page:vertical
{
background-color:#038387;
}

/*滚动条未滚过部分样式*/
#list1_vertical_scrollBar::add-page:vertical,#list2_vertical_scrollBar::add-page:vertical,#list3_vertical_scrollBar::add-page:vertical,#list4_vertical_scrollBar::add-page:vertical
{
background-color:#038387;
}

/*滚动条整体样式，需要单独设置的，在下面按照层次顺序指明，或者按照对象名设置 --start*/
/*垂直滚动条整体样式*/
QScrollBar:vertical
{
background-color:#3f3f48;/*背景颜色*/
width:8px;/*整体宽度*/
}

/*水平滚动条整体样式*/
QScrollBar:horizontal
{
background-color:#3f3f48;/*背景颜色*/
height:8px;/*整体高度*/
}

/*垂直滚动条内滑块样式*/
QScrollBar::handle:vertical
{
min-height:20px;/*滑块宽度*/
border-radius:4px;/*滑块角度弯曲*/
background-color:#038387;
}

/*水平滚动条内滑块样式*/
QScrollBar::handle:horizontal
{
min-width:20px;/*滑块高度*/
border-radius:4px;/*滑块角度弯曲*/
background-color:#038387;
}

/*垂直滚动条内滑块样式--hover*/
QScrollBar::handle:vertical:hover
{
background-color:#6b9fa7;
border-radius:4px;
}

/*水平滚动条内滑块样式--hover*/
QScrollBar::handle:horizontal:hover
{
background-color:#6b9fa7;
border-radius:4px;
}

/*垂直滚动条滑过上部分的样式*/
QScrollBar::sub-page:vertical
{
background-color:#25252a;
}

/*水平滚动条滑过左部分的样式*/
QScrollBar::sub-page:horizontal
{
background-color:#25252a;
}

/*垂直滚动条滑过下部分的样式*/
QScrollBar::add-page:vertical
{
background-color:#25252a;
}

/*水平滚动条滑过右部分的样式*/
QScrollBar::add-page:horizontal
{
background-color:#25252a;
}

/*
/*垂直滚动条滑过上部分的底部箭头部分样式*/
