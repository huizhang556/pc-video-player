/*托盘二级菜单-----------------样式开始*/
#m_menuTray,#m_playMode
{
background-color:white;
color:#2a2a31;
font:normal normal 13px '微软雅黑';
}

/*一级菜单tiem*/
#m_menuTray::item
{
height:28px;
padding: 2px 15px 2px 15px;/*上 右 下 左*/
border: 1px solid transparent;
}

/*二级菜单tiem*/
#m_playMode::item
{
height:28px;
padding: 2px 5px 2px 15px;/*上 右 下 左*/
border: 1px solid transparent;
}

/*鼠标滑过*/
#m_menuTray::item:selected,#m_playMode::item:selected
{
border-radius: 5px;
background: #90c8f6;
}

/*一级菜单--图标*/
#m_menuTray::icon
{
width:28px;
height:28px;
margin-left:10px;
}

/*二级菜单--图标*/
#m_playMode::icon
{
width:0px;
height:0px;
}

/*指示器---菜单勾选项*/
#m_menuTray::indicator,#m_playMode::indicator
{
margin:5px;
width:20px;
height:20px;
}

/*菜单项指示器---互斥--选中*/
#m_playMode::indicator:exclusive:checked
{
image: url(://images/tray/tray_checked.png);
}
/*托盘二级菜单-----------------------样式结束*/

/*帮助按钮菜单-----------------------样式开始*/
