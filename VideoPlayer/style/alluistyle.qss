/*********************浏览器---标题栏右键菜单************************/
/**一级菜单**/

#pmenu_funclist
{
border-radius:4px;
background-color: #ffffff;
width: 135px;
}

#pmenu_func_tool
{
border-radius:4px;
background-color: #ffffff;
width: 100px;
/*二级子菜单宽度是根据文字宽度决定，设置宽度item不会全部铺满*/
}

#pmenu_funclist::item
{
border-radius: 4px;
height: 26px;
padding-left:10px;
}

#pmenu_func_tool::item
{
border-radius: 4px;
height: 26px;
padding-left:10px;
}

#pmenu_funclist::item:selected
{
background-color: qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,stop:0 #6768ee, stop:1  #7184fb);
}

#pmenu_func_tool::item:selected
{
background-color: qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,stop:0 #6768ee, stop:1  #7184fb);
}

/**图标**/
#pmenu_funclist::icon
{
position: absolute;
top: 1px;
right: 1px;
bottom: 1px;
left: 1px;
}

/**图标**/
#pmenu_func_tool::icon
{
position: absolute;
top: 1px;
right: 1px;
bottom: 1px;
left: 1px;
}

/**分割线**/
#pmenu_funclist::separator
{
height: 1px;
background: #cccccc;
margin-left: 5px;
margin-right: 5px;
}

/**分割线**/
#pmenu_func_tool::separator
{
height: 1px;
background: #cccccc;
margin-left: 5px;
margin-right: 5px;

}
