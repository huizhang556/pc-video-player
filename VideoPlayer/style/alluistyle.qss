/*所有控件需要有明确的对象名称，需要设置共同样式，指明控件的层次次序*/
MainWidget
{
background-color:#2a2a31;
}

/*类选择器在代码里有效，样式表中无效，防止子控件继承样式*/
MultipPlayer
{
background-color:#2a2a31;
}

/*标题栏*/
TitleBar
{
color: rgb(85, 255, 0);
background-color: #2a2a31;
}

/*浏览器---收藏列表*/
#m_listWdgt_colloect
{
border:1px solid #bbbbbb;
color:#979aa4;
background-color: #f8f8f8;
border-radius:0px;
border-bottom-left-radius:6px;
border-bottom-right-radius:6px;
}

#m_listWdgt_colloect::item
{
background-color:#f0f0f0;
padding: 2px;
}

#m_listWdgt_colloect::icon:hover
{
border-image:url(://images/function/collect_list_item.png);
}

#m_listWdgt_colloect::item:selected
{
background-color: #d6eff7;
}

#m_listWdgt_colloect::item:hover
{
background-color: #ffffff;
color:#2b2b2b;
}

/*浏览器---搜索记录*/
#m_listWdgt_history
{
border:1px solid #bbbbbb;
color:#979aa4;
background-color: #f8f8f8;
border-bottom-left-radius:6px;
border-bottom-right-radius:6px;
}

#m_listWdgt_history::item
{
padding: 2px;
background-color:#f0f0f0;
}

#m_listWdgt_history::icon:hover
{
border-image:url(://images/function/history_list_item.png);
}

#m_listWdgt_history::item:selected
{
color:#3385ff;
}

#m_listWdgt_history::item:hover
{
background-color: #ffffff;
color:#2b2b2b;
}

/*新建任务---清除历史路径*/
#newwork_m_clearBtn
{
background: transparent;
color:#cdcdcd;
}

#newwork_m_clearBtn:hover
{
color:#ff4b38;
}

/*新建任务--历史记录列表*/
#newwork_m_listWdgt_path
{
background: white;
border:none;
}

/*新建任务---记录列表父窗口*/
#newwork_m_hisWdgt
{
background: white;
}

/*序号*/
#dl_num
{
/*border-image:url(://images/function/download_video.png);*/
}

/*进度条*/
#dl_progressbar
{
}

/*暂停按钮*/
#dl_stopbtn
{
border-image:url(://images/function/download_pause.png);
}

/*下载按钮*/
#dl_downloadlbtn
{
border-image:url(://images/function/download_download.png);
}

/*删除按钮*/
#dl_deletebtn
{
border-image:url(://images/function/download_delete.png);
}

/*打开按钮*/
#dl_openbtn
{
border-image:url(://images/function/download_openfile.png);
}

/*文件对话框*/
QFileDialog 
{
background-color:#f0f0f0;
}

QFileDialog QScrollBar::handle:vertical,QScrollBar::handle:horizontal
{
border-radius:0px;
background-color:#cdcdcd;
}

QFileDialog QScrollBar::handle:vertical:hover,QScrollBar::handle:horizontal:hover
{
border-radius:0px;
background-color:#cdcdcd;
}

QFileDialog QScrollBar::sub-page:vertical,QScrollBar::sub-page:horizontal
{
background-color:#f0f0f0;
}

QFileDialog QScrollBar::add-page:vertical,QScrollBar::add-page:horizontal
{
background-color:#f0f0f0;
}

/*浏览器----stackwidget-----start*/
#m_webTabWidget
{
background-color:#4969c7;
}

#m_webTabWidgetr::pane
{
background-color:#009999;
}

#m_webTabWidget::tab-bar
{
left:0px;
background-color:#009999;
height:24px;
}

/*tabbar样式*/
#m_webTabBar::tab
{
background-color:#4969c7;
border-top-left-radius: 8px;
border-top-right-radius: 8px;
min-width: 120px;
height:24px;
margin-left: 0px;
margin-right: 0px;
}

#m_webTabBar::tab:first
{
margin-left: 0px;
}

#m_webTabBar::tab:last
{
margin-right: 0px;
}

#m_webTabBar::tab:selected,#m_webTabBar::tab:hover
{
background-color:#3385ff;
}

#m_webTabBar::tab:!selected
{
margin-top: 0px;
background-color:#4969c7;
}

#m_webTabBar::close-button
{
image: url(://images/icon/tab_closebtn.png);
}

#m_webTabBar::close-button:hover
{
image: url(://images/icon/tab_closebtn_hover.png);
}
/*浏览器----stackwidget-----end*/

/*主界面底部按钮*/
#m_bottomBtn
{
border-radius:25px;
background: rbga(240, 240, 240,0.6) url(://images/icon/main_bottom_hover.png) no-repeat no-repeat center center;
}

#m_bottomBtn:hover
{
border-radius:25px;
background: rbga(240, 240, 240,0.6) url(://images/icon/main_bottombtn.png) no-repeat no-repeat center center;
}

/*推荐栏左右调节按钮*/
#m_recLeftBtn
{
border-radius:20px;
background: rbga(240, 240, 240,0.6) url(://images/icon/page_leftBtn.png) no-repeat no-repeat center center;
}
#m_recLeftBtn:hover
{
border-radius:20px;
background: rbga(240, 240, 240,0.6) url(://images/icon/page_leftBtn_hover.png) no-repeat no-repeat center center;
}

#m_recRightBtn
{
border-radius:20px;
background: rbga(240, 240, 240,0.6) url(://images/icon/page_rightBtn.png) no-repeat no-repeat center center;
}
#m_recRightBtn:hover
{
border-radius:20px;
background: rbga(240, 240, 240,0.6) url(://images/icon/page_rightBtn_hover.png) no-repeat no-repeat center center;
}

/*去白边*/
#m_tabWdgt::pane 
{
border-right: 0;
background-color: #3b3b45;
}

#m_tabWdgt::tab-bar 
{
left: 35px;
}

#m_homeListWidget
{
background-color:#2a2a31;
border:none;
}

#m_homeListWidget::item
{
background-color:#2a2a31;
border:none;
}

QListWidget QTabWidget QStackWidget QTextBrowser
{
outline:0;
border:none;/*去边线*/
}

MainWindow
{
background-color:#2a2a31;
color: rgb(85, 255, 0);
}

/*全局通过用样式*/
* {
outline:none;
}

/*去白边*/
QTabWidget::pane 
{
border-right: 0;
}

/*---侧边栏列表---*/
#listWidget_playlist
{
background-color: rgb(43, 43, 43);
font-family:"微软雅黑";
border:none;/*去掉边框线*/
icon-size:50px;
font-size:14px;
text-align:center;
}

/*侧边栏列表item*/
#listWidget_playlist::item
{
color:#cccccc;
background-color: rgb(43, 43, 43);
min-height:50px;/*有效设置item高度*/
padding-left:20px;
}

#listWidget_playlist::item:hover
{
show-decoration-selected:5;
/*background-color: qconicalgradient(cx:0.5, cy:0.522909, angle:179.9, 
stop:0.494318 rgba(181, 225, 250, 255), stop:0.5 rgba(222, 242, 251, 255));*/
border-style:outset;
color:#FF7F24;
background-color: rgb(33, 33, 33);
}

#listWidget_playlist::item:selected
{
/*border:1px solid #55ff00;*/
background:#382e15;
color:#ff5c38;
}

/*上次选择后保留的状态，鼠标离开后显示*/
#listWidget_playlist::item:selected:!active
{
border-width:0px;
background:#382e15;
margin:0px;
color: rgb(85, 255, 0);
}

/*侧边栏底部--展开按钮*/
#m_expandBtn
{
background-color: rgb(43, 43, 43);
text-align:left;
icon-size:35px;
font-family:"微软雅黑";
font-size:14px;
color:#cccccc;
padding-left:38px;
}

#m_expandBtn:hover
{
background-color: rgb(33, 33, 33);
color:rgb(255, 94, 30);
}

/*托盘二级菜单-----------------样式开始*/
#m_menuTray,#m_playMode
{
background-color:white;
color:#2a2a31;
font:normal normal 15px '微软雅黑';
}

/*一级菜单tiem*/
#m_menuTray::item
{
height:30px;
padding: 2px 15px 2px 15px;/*上 右 下 左*/
border: 1px solid transparent;
}

/*二级菜单tiem*/
#m_playMode::item
{
height:30px;
padding: 2px 5px 2px 15px;/*上 右 下 左*/
border: 1px solid transparent;
}

/*鼠标滑过*/
#m_menuTray::item:selected,#m_playMode::item:selected
{
border-radius: 5px;
background: #90c8f6;
}

/*一级菜单--图标*/
#m_menuTray::icon
{
width:30px;
height:30px;
margin-left:10px;
}

/*二级菜单--图标*/
#m_playMode::icon
{
width:0px;
height:0px;
}

/*指示器---菜单勾选项*/
#m_menuTray::indicator,#m_playMode::indicator
{
margin:5px;
width:20px;
height:20px;
}

/*菜单项指示器---互斥--选中*/
#m_playMode::indicator:exclusive:checked
{
image: url(://images/tray/tray_checked.png);
}
/*托盘二级菜单-----------------------样式结束*/

/*帮助按钮菜单-----------------------样式开始*/
#pmenu_help1,#pmenu_help2
{
background-color:white;
color:#2a2a31;
font:normal normal 15px '微软雅黑';
}

#pmenu_help1::item
{
height:18px;
padding: 4px 28px 4px 20px;/*上 右 下 左*/
border: 1px solid transparent;
}

#pmenu_help2::item
{
height:18px;
padding: 4px 8px 4px 12px;/*上 右 下 左*/
border: 1px solid transparent;
margin:0px;
}

#pmenu_help1::item:selected,#pmenu_help2::item:selected
{
border-radius: 5px;
background: #00aabf;
}

#pmenu_help1::icon,#pmenu_help2::icon
{
width:10px;
height:20px;
margin-left:10px;
}
/*帮助按钮菜单-----------------------样式结束*/

/*歌曲右键菜------------------------------开始*/
#pmenu_songer,#pmenu_son_addto,#pmenu_son_sort,#pmenu_son_playmode,#pmenu_son_muctool
{
background: white;
color:#2a2a31;
font:normal normal 15px '微软雅黑';
}

#pmenu_songer::item,#pmenu_son_addto::item,#pmenu_son_sort::item,#pmenu_son_playmode::item,#pmenu_son_muctool::item
{
height:18px;
padding: 4px 28px 4px 20px;/*上 右 下 左*/
border: 1px solid transparent;
}

#pmenu_songer::item:selected,#pmenu_son_addto::item:selected,#pmenu_son_sort::item:selected,#pmenu_son_playmode::item:selected,#pmenu_son_muctool::item:selected
{
background: #00aabf;
}

#pmenu_songer::icon,#pmenu_son_addto::icon,#pmenu_son_sort::icon,#pmenu_son_playmode::icon,#pmenu_son_muctool::icon
{
width:20px;
height:18px;
margin-left:10px;
}
/*歌曲右键菜单-----------------------------结束*/

/*播放列表，收藏列表，历史列表右键菜单---开始*/
#playlist_playMenu,#playlist_collectMenu,#playlist_historytMenu
{
background-color:white;
width:100px;
border-radius:20px;
}

#playlist_playMenu::item,#playlist_collectMenu::item,#playlist_historytMenu::item
{
background-color:white;
}

#playlist_playMenu::item:selected,#playlist_collectMenu::item:selected,#playlist_historytMenu::item:selected
{
color:#2ca5fc;
background-color:#cccccc;
}

/*播放列表，收藏列表，历史列表右键菜单---结束*/

QDockWidget#m_dockWidget::title
{
text-align: center; 
background-color:rgb(101,210,105);
padding-left: 5px;
}

/*通过icon-size来撑大item的高度*/
QToolBox
{
border-right:2px;
background-color:#3d3d3d;
 icon-size: 25px; 
}

/*节目列表tabwidget*/
#m_tabWidget1
{
outline:none;
background-color:#3d3d3d;
color:black;
}

#m_tabWidget1 QTabBar::tab
{
width:130px;
height:35px;
color: white;
background-color:#3f3f48;
}

#m_tabWidget1 QTabBar::tab:first
{
/*border-right:1px solid #ff5c38;*/
}

#m_tabWidget1 QTabBar::tab:!selected
{
margin-top: 0px;
}

#m_tabWidget1 QTabBar::tab:selected
{
color:#ff5c38;
font-size:14px;
font-weight:bold;
border-bottom:2px solid #ff5c38;
}

/*抽屉控件,有效*/
QToolBox::tab
{
/*border: 2px groove transparent; */
border-bottom:2px groove blue; 
border-radius:2px;
background-color:#3d3d3d;
text-align: center; 
}

/*tab样式-hover*/
QToolBox::tab:hover
{
background-color:rgb(101,210,105);
color:lightgreen;
}

/*tab样式-selected*/
QToolBox::tab:selected
{
/*background-color:#7f7f7f;*/
background-color:rgb(101,210,105);
/*color:lightgreen;*/
}

