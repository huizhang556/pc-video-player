/*所有控件需要有明确的对象名称，需要设置共同样式，指明控件的层次次序*/
/**所有的注释不要使用双斜杠!!!**/
/*全局通过用样式*/
* {
outline:none;
}

/**依旧是万能大法所有可视化类的 Q_PROPERTY 包含的属性都可以这样设置**/
/**对整个系统的选项卡设置无切换按钮**/
QTabBar
{
/*对整个系统的选项卡设置无切换按钮*/
/*等同于ui->tabWidget->tabBar()->setUsesScrollButtons(false);*/
qproperty-usesScrollButtons: false;
}

/*去白边*/
QTabWidget::pane 
{
border-right: 0;
}

/**登录状态按钮**/
#m_loginStatusBtn
{
border-radius: 7px;
background-color: #c0ff02;
}

MainWidget
{
/*整个主界面大背景，所有背景透明都继承此背景颜色*/
background-color: #2a2a31;
/*2px边界线颜色在这里设置*/
}

/*********QWebEngineView，所有的样式在html页面中设置********/


/*主界面标题栏---内衬*/
#stackedWidget_title
{
background-color:qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,stop:0 #2f4359, stop:1  #03223a);
color: rgb(85, 255, 0);
}

/*播放器界面标题栏---内衬*/
#stackedWidget_videoTitle
{
background-color:qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0, stop:0 #055690, stop:1  #081f4a);
}

/*类选择器在代码里有效，样式表中无效，防止子控件继承样式*/
MultipPlayer
{
/*包含2px的margin*/
background-color: #2a2a31;
}

/*---左侧节目侧边栏列表---*/
#listWidget_playlist
{
font-family:"微软雅黑";
border:none;
icon-size:50px;
font-size:14px;
text-align:center;
background-color:qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,stop:0 #28405d, stop:1  #223a55);
}

/*侧边栏列表item*/
#listWidget_playlist::item
{
color: #cccccc;
width:170px;
height:50px;
min-height:50px;/*有效设置item高度*/
padding-left: 8px;
background-color:qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,stop:0 #28405d, stop:1  #223a55);
}

#listWidget_playlist::item:hover
{
show-decoration-selected:5;
border-style:outset;
color:#FF7F24;
background-color:qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,stop:0 #630f34, stop:1  #c2152f);
}

#listWidget_playlist::item:selected
{
color: #005e9e;
font-weight: bold;
}

/*上次选择后保留的状态，鼠标离开后显示*/
#listWidget_playlist::item:selected:!active
{
background-color:qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,stop:0 #0f2028, stop:1  #2d5364);
color: #008bb5;
}

/*侧边栏底部--展开按钮*/
#m_expandBtn
{
background-color:qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,stop:0 #28405d, stop:1  #223a55);
text-align: center;
icon-size:35px;
font-family:"微软雅黑";
font-size:14px;
color:#cccccc;
border:none;
}

#m_expandBtn:hover
{
background-color:qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,stop:0 #630f34, stop:1  #c2152f);
color:#FF7F24;
}

#m_expandBtn:selected
{
color: #005e9e;
}

/**主界面折叠按钮**/
#m_leftButton
{
/*宽度需要在20px以上*/
border-top-right-radius:10px;
border-bottom-right-radius:10px;
}

/***播放器主界面折叠按钮***/
#m_foldBtn
{
/*此处只做圆角修改，其他部分样式代码设置*/
background-color: transparent;
}

/*推荐栏左右调节按钮*/
#m_recLeftBtn
{
border-radius:20px;
background: rbga(240, 240, 240,0.6) url(://images/icon/page_leftBtn.png) no-repeat no-repeat center center;
}
#m_recLeftBtn:hover
{
border-radius:20px;
background: rbga(240, 240, 240,0.6) url(://images/icon/page_leftBtn_hover.png) no-repeat no-repeat center center;
}

#m_recRightBtn
{
border-radius:20px;
background: rbga(240, 240, 240,0.6) url(://images/icon/page_rightBtn.png) no-repeat no-repeat center center;
}
#m_recRightBtn:hover
{
border-radius:20px;
background: rbga(240, 240, 240,0.6) url(://images/icon/page_rightBtn_hover.png) no-repeat no-repeat center center;
}

/*收藏记录---修改*/
WebMessageBox
{
background-color: #ffffff;
}

/*中心控件承载区域（历史和收藏的大背景）*/
#m_webStackWgt
{
