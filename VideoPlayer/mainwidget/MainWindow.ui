                <property name="styleSheet">
                 <string notr="true">/*整个进度条*/
QSlider::groove:horizontal 
{
background:transparent;
height: 6px;
border-radius:3px;
}


/*整个进度条-hover*/
QSlider::groove:horizontal:hover
{
background:transparent;
height: 6px;
border-radius:3px;
}

/*J拖动按钮*/
QSlider::handle:horizontal 
{

background: qradialgradient(spread:pad, cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, 
stop:0.6 #45ADED, stop:0.778409 rgba(255, 255, 255, 255));
height:8px;
width:8px;
margin-top: -2px;
margin-bottom: -2px;
padding-right:1px;
border-radius:4px;
border:1px solid white;

/*
border-image: url(:/images/Slider.png);
width: 20px;          
height:20px;           
margin-top: -4px;      
margin-bottom: -4px;
border-radius: 10px;  
*/
}

/*J拖动按钮-hover,只跟groove的hover时高度影响*/
QSlider::handle:horizontal:hover 
{

}

/*未划过的区域，右边界线*/
QSlider::add-page:horizontal,QSlider::add-line:horizontal
{
border-radius:2px;
background-color: rgb(87, 97, 106); 
}

/*已划过的区域，右边界线*/
QSlider::sub-page:horizontal,QSlider::sub-line:horizontal
{
border-radius:2px;
background-color:qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(231,80,229, 255), stop:1 rgba(7,208,255, 255));
}
</string>
