          <string notr="true">/*QListWidget节目列表*/
QListWidget 
{
/*background-color:qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0,
stop:0 rgba(231,80,229, 255), 
stop:1 rgba(7,208,255, 255));*/
background-color: rgb(43, 43, 43);
font-family:&quot;微软雅黑&quot;;
border:none;/*去掉边框线*/
icon-size:50px;
font-size:14px;
text-align:center;
}

QListWidget::item
{
color:#cccccc;
background-color: rgb(43, 43, 43);
min-height:50px;/*有效设置item高度*/
}

QListWidget QLabel
{
/*icon-size:25px;*/
/*font:bold italic 18px &quot;微软雅黑&quot;;*/
font-family:&quot;微软雅黑&quot;;
font-size:15px;
color:#cccccc;
background-color:#3a3a3a;
min-height:50px;
}


QListWidget::item:hover
{
show-decoration-selected:5;
/*background-color: qconicalgradient(cx:0.5, cy:0.522909, angle:179.9, 
 stop:0.494318 rgba(181, 225, 250, 255), stop:0.5 rgba(222, 242, 251, 255));*/
border-style:outset;
color:#FF7F24;
background-color: rgb(33, 33, 33);
}

QListWidget QLabel:hover
{
    show-decoration-selected:5;
    /*background-color: qconicalgradient(cx:0.5, cy:0.522909, angle:179.9, 
       stop:0.494318 rgba(181, 225, 250, 255), stop:0.5 rgba(222, 242, 251, 255));*/
    background-color:transparent;
    border-style:outset;
    color:#FF7F24;	
}


QListWidget::item:selected
{
 /*border:0px;*/
    /*border:1px solid #55ff00;*/
    background:#382e15;
    padding:0px;
    margin:0px;
    color:#ff5c38;
}

QListWidget QLabel:selected
{
    /*border:0px;*/
    /*border:1px solid #55ff00;*/
    background:#382e15;
    padding:0px;
    margin:0px;
    color:#ff5c38;
}

/*上次选择后保留的状态，鼠标离开后显示*/
QListWidget::item:selected:!active
{
    border-width:0px;
    background:#382e15;
    padding:0px;
    margin:0px;
    color: rgb(85, 255, 0);
}</string>
