#songlist_vertical_scrollBar:vertical
{
background-color:#7fbd42;/*背景颜色*/
width:16px;/*整体宽度*/
}

/*四个列表的滚动条---单独的统一放在通用样式之前设置*/
#songlist_vertical_scrollBar::handle:vertical
{
max-height:80px;
background-color: #9566ff;
}

/*鼠标放到滑块上面样式*/
#songlist_vertical_scrollBar::handle:vertical:hover
{
background-color: #a254ff;
}

/*滚动条滚过部分样式*/
#songlist_vertical_scrollBar::sub-page:vertical
{
background-color: #324d5b;
}

/*滚动条未滚过部分样式*/
#songlist_vertical_scrollBar::add-page:vertical
{
background-color: #324d5b;
}
