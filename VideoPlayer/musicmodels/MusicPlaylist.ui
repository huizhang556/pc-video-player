background-color: rgb(80, 80, 80);
}

/*横表头*/
QHeaderView::section:horizontal
{
min-height:30px;
border:0;
border-bottom:1px solid rgb(0, 170, 255);
background-color: qlineargradient(spread:pad, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(60, 60, 60, 255), stop:0.301136 rgba(40, 40, 40, 255), stop:0.909091 rgba(68, 68, 68, 255));
}

/*竖表头*/
QHeaderView::section:vertical
{
min-width:60px;
padding-left:15px;
border:1px solid rgb(128, 128, 128);
border-top:0;
border-left:0;
background-color: qlineargradient(spread:pad, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(60, 60, 60, 255), stop:0.301136 rgba(40, 40, 40, 255), stop:0.909091 rgba(68, 68, 68, 255));
}

QHeaderView::section
{
font: 15px &quot;楷体&quot;;
}

QHeaderView::section:hover
{
color:black;
/*background-color: qlineargradient(spread:pad, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(255, 177, 21, 255), stop:0.335227 rgba(245, 163, 0, 255), stop:0.909091 rgba(255, 192, 66, 255));*/
}

QHeaderView::section:checked
{/*不取消高亮*/
font: 15px &quot;楷体&quot;;
color: rgb(255, 170, 0);
}

QHeaderView::section:selected
{
font: 15px &quot;楷体&quot;;
color: rgb(255, 170, 0);
}

QHeaderView::section:checked:hover
{
color: rgb(230, 230, 230);
}

QHeaderView::section:first
{/*表头第一个位置*/
}

QHeaderView::down-arrow
{/*图标用来排序的*/
}

QHeaderView::up-arrow{
}

/*QTableView节目列表*/
QTableView 
{
/*background-color:qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0,
stop:0 rgba(231,80,229, 255), 
stop:1 rgba(7,208,255, 255));*/
background-color: rgb(43, 43, 43);
font-family:&quot;楷体&quot;;
border:none;/*去掉边框线*/
icon-size:50px;
font-size:14px;
text-align:center;
outline:0px;/*去掉选中item时候的边线*/
border: none;
}

QTableView::item
{
color:#cccccc;
background-color: rgb(43, 43, 43);
min-height:30px;
}

QTableView QLabel
{
/*icon-size:25px;*/
/*font:bold italic 18px &quot;微软雅黑&quot;;*/
font-family:&quot;楷体&quot;;
font-size:15px;
color:#cccccc;
background-color:#3a3a3a;
min-height:50px;
}


QTableView::item:hover
{
show-decoration-selected:5;
border-style:outset;
color:#FF7F24;
background-color: #43a2ce
}

QTableView QLabel:hover
{
    show-decoration-selected:5;
    /*background-color: qconicalgradient(cx:0.5, cy:0.522909, angle:179.9, 
       stop:0.494318 rgba(181, 225, 250, 255), stop:0.5 rgba(222, 242, 251, 255));*/
    background-color:transparent;
    border-style:outset;
    color:#FF7F24;	
}


QTableView::item:selected
{
 /*border:0px;*/
    /*border:1px solid #55ff00;*/
    background:#382e15;
    padding:0px;
    margin:0px;
    color:#ff5c38;
}

QTableView QLabel:selected
{
    /*border:0px;*/
    /*border:1px solid #55ff00;*/
    background:#382e15;
    padding:0px;
    margin:0px;
    color:#ff5c38;
}

/*上次选择后保留的状态，鼠标离开后显示*/
QTableView::item:selected:!active
{
    border-width:0px;
    background:#382e15;
    padding:0px;
    margin:0px;
    color: rgb(85, 255, 0);
}</string>
                  </property>
