}

/*下拉项样式 背景蓝色*/
QListView::item
{
min-height:28px;
padding:0px 0px;
font: 400 14px &quot;微软雅黑&quot;;
background-color: rgba(0, 80, 106,0.3);	
color:#2ca5f9;

}  

/*下拉项选中样式（效果不明显）背景绿色*/
QListView::item:selected
{ 
color:#2ca5f9;
border-radius: 2px;
background-color: rgba(0, 80, 106,0.5);	 
}   

/*下拉项鼠标悬浮样式 背景灰绿色*/
QListView::item:hover
{ 
color: rgb(39, 255, 22);
border-radius: 2px;
background-color: rgba(0, 80, 106,0.5);	 
}

QToolTip
{
background-color:#f0f0f0;
color:#404040;
}



