                   <property name="styleSheet">
                    <string notr="true">QComboBox#comboBox_type
{
color:#2ca5f9;
border-radius: 4px;
padding-right: 100px;
font: 400 14px &quot;微软雅黑&quot;;
border:1px solid rgb(50, 173, 241);
background-color: rgb(170, 170, 255);
}

QComboBox#comboBox_type:hover
{
color: rgb(39, 255, 22);
border:1px solid rgb(223, 82, 251);
}

QComboBox#comboBox_type::drop-down
{
border: 0px solid rgb(50, 173, 241);
border-left-width: 1px;
background-color: transparent;
width: 12px;
}

QComboBox#comboBox_type::down-arrow
{
image: url(:/images/function/download_arrow_hover.png);
}

/*下拉列表item*/
QComboBox#comboBox_type QAbstractItemView 
{
height: 100px;
border: 0px solid green;
selection-background-color: blue;						/*选中下拉列表行背景色*/
background-color: rgba(32, 38, 48,0.7);								/*下拉列表背景色*/
}

/*下拉项样式 背景蓝色*/
QListView::item
{
min-height:26px;
padding:0px 0px;
background-color: rgba(32, 38, 48,0.7);	
color:#2ca5f9;

}  

/*下拉项选中样式（效果不明显）背景绿色*/
QListView::item:selected
{ 
color:#2ca5f9;
border-radius: 2px;
background-color: rgba(32, 38, 48,0.4);	 
}   

/*下拉项鼠标悬浮样式 背景灰绿色*/
QListView::item:hover
{ 
color: rgb(39, 255, 22);
border-radius: 2px;
background-color: rgba(32, 38, 48,0.4);	 
}

QToolTip
{
background-color:#f0f0f0;
color:#404040;
}

</string>
