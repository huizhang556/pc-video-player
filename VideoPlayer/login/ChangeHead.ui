         <widget class="QTabWidget" name="tabWidget_change">
          <property name="styleSheet">
           <string notr="true">QTabWidget::pane 
{
border-top: 0px solid rgba(58, 58, 65,0.9);
background-color: transparent;
}

QTabWidget::tab-bar 
{
left: 0px; /* move to the right by 5px */
}

QTabBar::tab 
{
background-color: transparent;
/*border: 2px solid #C4C4C3;*/
/*border-bottom-color: #C2C7CB;*/
border-top-left-radius: 0px;
border-top-right-radius: 0px;
min-width: 100px;
height:30px;
padding: 2px;
margin: 0px 2px;	
font: 75 11pt &quot;Microsoft YaHei UI&quot;;
}

QTabBar::tab:hover 
{
border-radius: 15px;
background-color:qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,stop:0 #d9f8fd, stop:0.5 #abf0f9, stop:1 #d9f8fd);
}

QTabBar::tab:selected 
{
font: 800 15px &quot;微软雅黑&quot;;
color: #fbe145;
border-radius: 16px;
border: 0px solid #9B9B9B;
background-color:qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,stop:0 #2fd6f9, stop:0.5 #1f73de, stop:1  #2fd6f9);
}

QTabBar::tab:!selected 
{
color: #7e7f81;
margin-top: 0px;
}


QTabBar::tab:first:selected 
{
margin-left: 0; 
}

QTabBar::tab:last:selected 
{
margin-right: 0;
}

QTabBar::tab:only-one 
{
 margin: 0; 
}

QGroupBox
{
border: 1px solid #8b98a0;
border-radius: 6px;
margin-top: 5ex;
font: 10pt &quot;Microsoft YaHei UI&quot;;
background-color: transparent;
}

QGroupBox::title 
{
color: #00ceee;
subcontrol-origin: margin;
subcontrol-position: top left;
padding: 0 5px;
}

