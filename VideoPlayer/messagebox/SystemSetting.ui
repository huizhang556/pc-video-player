            <string notr="true">/*QListWidget节目列表*/
QListWidget 
{
/*background-color:qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0,
stop:0 rgba(231,80,229, 255), 
stop:1 rgba(7,208,255, 255));*/
background-color: rgb(245, 245, 245);
font-family:&quot;微软雅黑&quot;;
border:transparent;/*去掉边框线*/
border-right:1px solid #cdcdcd;
icon-size:40px;
font-size:14px;
}

QListWidget::item
{
color: rgb(102, 102, 102);
background-color: rgb(245, 245, 245);
selection-background-color: rgb(255, 100, 0);
min-height:40px;/*有效设置item高度*/
text-align:center;
}

QListWidget::item:hover
{
show-decoration-selected:5;
/*background-color: qconicalgradient(cx:0.5, cy:0.522909, angle:179.9, 
 stop:0.494318 rgba(181, 225, 250, 255), stop:0.5 rgba(222, 242, 251, 255));*/
border-style:outset;
color: rgb(102, 102, 102);
background-color: rgb(204, 204, 204);
}

QListWidget::item:selected
{
 /*border:0px;*/
    /*border:1px solid #55ff00;*/
	background-color: rgb(204, 204, 204);
    padding:0px;
    margin:0px;
	color: rgb(255, 255, 255);
}

/*上次选择后保留的状态，鼠标离开后显示*/
QListWidget::item:selected:!active
{
    border-width:0px;
	background-color: rgb(204, 204, 204);
    padding:0px;
    margin:0px;	
	color: rgb(255, 255, 255);
}</string>
