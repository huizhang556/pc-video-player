QTabBar::tab 
{
color: #ffffff;
font: 400 16px &quot;微软雅黑&quot;;
border: 0px solid green;
border-top-left-radius: 4px;
border-top-right-radius: 4px;
min-width: 120px;
min-height:36px;
margin: 0px 1px;
background-color: transparent;
}

QTabBar::tab:selected
{
color: #70fffe;
font: 800 17px &quot;微软雅黑&quot;;
/*background-color: #3ed1fd;*/
}

QTabBar::tab:hover 
{
color: #70fffe;
font: 800 17px &quot;微软雅黑&quot;;
}

QTabBar::tab:!selected 
{
margin-top: 0px;
}

QTabBar::tab:first:selected 
{
margin-left: 0;
}

QTabBar::tab:last:selected 
{
margin-right: 0;
}

QTabBar::tab:only-one 
{
margin: 0;
}</string>
